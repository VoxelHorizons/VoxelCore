         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>org.voxelhorizons</groupId><artifactId>VoxelCore</artifactId><version>1.0-SNAPSHOT</version></parent>
    <artifactId>voxelcore-dist-v1_21_4</artifactId>
