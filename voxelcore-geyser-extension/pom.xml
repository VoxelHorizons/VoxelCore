<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.voxelhorizons</groupId>
        <artifactId>VoxelCore</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>voxelcore-geyser-extension</artifactId>
    <name>VoxelCore Geyser Extension</name>
    <properties>
        <!-- Geyser 26.2+ requires Java 17+; Java 21 is supported on current Paper 26.3. -->
        <maven.compiler.release>21</maven.compiler.release>
        <geyser.api.version>2.12.1-SNAPSHOT</geyser.api.version>
    </properties>
    <repositories>
        <repository>
            <id>opencollab</id>
            <url>https://repo.opencollab.dev/main/</url>
        </repository>
    </repositories>
    <dependencies>
        <dependency>
            <groupId>org.geysermc.geyser</groupId>
            <artifactId>api</artifactId>
            <version>${geyser.api.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Internals for registering the item_display Java type (ItemDisplayRegistration only). -->
        <dependency>
            <groupId>org.geysermc.geyser</groupId>
            <artifactId>core</artifactId>
            <version>${geyser.api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.15.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <finalName>VoxelCore-GeyserExtension-${project.version}</finalName>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
